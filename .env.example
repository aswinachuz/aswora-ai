# ==========================================
# Aswora AI — Environment Configuration
# ==========================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aswora-ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aswora-ai

# Security & Authentication
JWT_SECRET=aswora-ai-dev-jwt-secret-replace-with-cryptographic-key-in-production
JWT_EXPIRES_IN=7d

# Primary AI Provider Configuration
# Options: 'groq' | 'openrouter' | 'ollama' | 'mock'
DEFAULT_AI_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# Cloud Inference: Groq (Llama 3.3 70B, Llama 3.1 8B, Mixtral 8x7B)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cloud Inference: OpenRouter (Qwen 2.5 72B, DeepSeek R1)
# Get a key at: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Inference: Ollama (Optional)
# Download at: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# Safety, Rate Limiting & Resource Safeguards
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
CHAT_RATE_LIMIT_MAX=60
MAX_MESSAGE_LENGTH=8000
MAX_HISTORY_TOKENS=6000
